{
	"hosting": [
		{
			"target": "webapp",
			"public": "apps/webapp/dist",
			"ignore": [
				"firebase.json",
				"**/.*",
				"**/node_modules/**",
				"**/*.map"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/index.html"
				}
			],
			"headers": [
				{
					"regex": "^/[^.]*$",
					"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
				},
				{
					"source": "/@(index.html|sw.js|firebase-messaging-sw.js|manifest.webmanifest)",
					"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
				},
				{
					"source": "/assets/**",
					"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
				}
			]
		},
		{
			"target": "admin",
			"public": "apps/admin/dist",
			"ignore": [
				"firebase.json",
				"**/.*",
				"**/node_modules/**",
				"**/*.map"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/index.html"
				}
			],
			"headers": [
				{
					"regex": "^/[^.]*$",
					"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
				},
				{
					"source": "/@(index.html|sw.js|manifest.webmanifest)",
					"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
				},
				{
					"source": "/assets/**",
					"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
				}
			]
		}
	],
	"firestore": {
		"rules": "firebase/firestore.rules",
		"indexes": "firebase/firestore.indexes.json"
	},
	"storage": {
		"rules": "firebase/storage.rules"
	},
	"functions": [
		{
			"source": "apps/functions",
			"codebase": "default",
			"ignore": [
				"node_modules",
				"*.local"
			]
		}
	],
	"emulators": {
		"auth": {
			"port": 9099
		},
		"firestore": {
			"port": 8080
		},
		"storage": {
			"port": 9199
		},
		"functions": {
			"port": 5001
		},
		"ui": {
			"enabled": true
		}
	}
}
