{
	"hosting": [
		{
			"target": "webapp",
			"public": "apps/webapp/dist",
			"ignore": [
				"firebase.json",
				"**/.*",
				"**/node_modules/**"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/index.html"
				}
			]
		},
		{
			"target": "admin",
			"public": "apps/admin/dist",
			"ignore": [
				"firebase.json",
				"**/.*",
				"**/node_modules/**"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/index.html"
				}
			]
		}
	],
	"firestore": {
		"rules": "firestore.rules"
	},
	"emulators": {
		"auth": { "port": 9099 },
		"firestore": { "port": 8080 },
		"ui": { "enabled": true }
	}
}
