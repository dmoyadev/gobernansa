{
	"hosting": [
		{
			"target": "webapp",
			"public": "apps/webapp/dist",
			"ignore": [
				"firebase.json",
				"**/.*",
				"**/node_modules/**",
				"**/*.map"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/index.html"
				}
			],
			"headers": [
				{
					"regex": "^/[^.]*$",
					"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
				},
				{
					"source": "/@(index.html|sw.js|firebase-messaging-sw.js|manifest.webmanifest)",
					"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
				},
				{
					"source": "/assets/**",
					"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
				}
			]
		},
		{
			"target": "admin",
			"public": "apps/admin/dist",
			"ignore": [
				"firebase.json",
				"**/.*",
				"**/node_modules/**",
				"**/*.map"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/index.html"
				}
			],
			"headers": [
				{
					"regex": "^/[^.]*$",
					"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
				},
				{
					"source": "/@(index.html|sw.js|manifest.webmanifest)",
					"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
				},
				{
					"source": "/assets/**",
					"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
				}
			]
		},
		{
			"target": "landing",
			"public": "apps/landing",
			"ignore": [
				"firebase.json",
				"**/.*"
			],
			"cleanUrls": true,
			"headers": [
				{
					"source": "/@(fonts|img)/**",
					"headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
				}
			]
		}
	],
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"emulators": {
		"auth": { "port": 9099 },
		"firestore": { "port": 8080 },
		"ui": { "enabled": true }
	}
}
