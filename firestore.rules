// Security rules for what the app reads and writes. Deployed by CI on every push to main
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The signed in user's profile. Each rule that uses it costs one extra read, once per request
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function inCommunity(communityId) {
      return signedIn() && me().communityId == communityId;
    }

    // gobernança's team, who manage every community and the administrators
    function isSuperadmin() {
      return signedIn() && me().role == 'superadmin';
    }

    // Administrators manage the communities assigned to them, and managers the one they live in.
    // Mirrored by managesCommunity() in packages/shared/domain/user.ts
    function manages(communityId) {
      return signedIn() && (
        me().role == 'superadmin'
        || (me().role == 'admin' && communityId in me().get('communityIds', []))
        || (me().role == 'manager' && communityId == me().communityId)
      );
    }

    // Neighbours and whoever manages it, from the admin platform
    function inOrManages(communityId) {
      return inCommunity(communityId) || manages(communityId);
    }

    // Who can give a role in a community: administrators make managers and neighbours in theirs, managers only neighbours.
    // Mirrored by assignableRoles() in packages/shared/domain/user.ts
    function canAssign(role, communityId) {
      return signedIn() && role in ['superadmin', 'admin', 'manager', 'user'] && (
        me().role == 'superadmin'
        || (me().role == 'admin' && role in ['manager', 'user'] && communityId in me().get('communityIds', []))
        || (me().role == 'manager' && role == 'user' && communityId == me().communityId)
      );
    }

    // Email sign-in links verify it. Anyone can create a password account with any email, so an unverified one could claim someone else's invitation
    function isInvitee(email) {
      return signedIn() && request.auth.token.email == email && request.auth.token.email_verified == true;
    }

    // The profile created on the first sign-in, exactly as the invitation sent to their email says
    function matchesInvitation(profile) {
      let invitation = get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data;
      return isInvitee(request.auth.token.email)
        && profile.keys().hasOnly(['email', 'name', 'role', 'communityId', 'communityIds'])
        && profile.email == request.auth.token.email
        && profile.name == invitation.name
        && profile.role == invitation.role
        && profile.communityId == invitation.communityId
        && profile.get('communityIds', []) == invitation.get('communityIds', []);
    }

    // Blocked by whoever manages their community: they can read, but not report, comment, vote, book or answer meetings
    function notBlocked() {
      return me().get('blocked', false) != true;
    }

    // Administrators and managers share providers between the communities they manage
    function sharesWith(communityIds) {
      return signedIn() && (
        me().role == 'superadmin'
        || (me().role == 'admin' && communityIds.hasAny(me().get('communityIds', [])))
        || (me().role == 'manager' && me().communityId in communityIds)
      );
    }

    // The communities someone can add a provider to or take it from: all for the team, theirs for administrators, their own for managers
    function canShareWith(communityIds) {
      return signedIn() && (
        me().role == 'superadmin'
        || (me().role == 'admin' && communityIds.hasOnly(me().get('communityIds', [])))
        || (me().role == 'manager' && communityIds.hasOnly([me().communityId]))
      );
    }

    // The property is theirs, in the community it's voted in
    function ownsProperty(communityId, propertyId) {
      let property = get(/databases/$(database)/documents/properties/$(propertyId)).data;
      return property.communityId == communityId && property.ownerUid == request.auth.uid;
    }

    // The property is theirs, in the community it's voted in, with the coefficient it has
    function ownsWithCoefficient(communityId, propertyId, coefficient) {
      let property = get(/databases/$(database)/documents/properties/$(propertyId)).data;
      return property.communityId == communityId && property.ownerUid == request.auth.uid && property.get('coefficient', 0) == coefficient;
    }

    // The score the user had given the provider before this request, 0 if none
    function previousScore(providerId) {
      let path = /databases/$(database)/documents/providers/$(providerId)/ratings/$(request.auth.uid);
      return exists(path) ? get(path).data.score : 0;
    }

    // Names are kept with what people write, so showing them doesn't read every profile. They must be their own
    function isMyName(name) {
      return name == me().get('name', '');
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Online payments by neighbours are only taken while the community has them in test mode
    function testPayments(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)).data.get('onlinePayments', '') == 'test';
    }

    // Only the brand and the last 4 digits, so a card number can never be stored
    function isCardSummary(payment) {
      return !('card' in payment) || (payment.card.keys().hasOnly(['brand', 'last4']) && payment.card.brand is string && payment.card.last4.matches('[0-9]{4}'));
    }

    // A charge or booking paid from the app points to its payment, written in the same request by the same neighbour, of exactly what was left to pay
    function paidOnline(communityId, payment, field, id, amount) {
      let written = getAfter(/databases/$(database)/documents/communities/$(communityId)/payments/$(payment.id)).data;
      return payment.keys().hasOnly(['id', 'mode', 'method', 'card'])
        && payment.mode == 'test'
        && payment.method == written.method
        && isCardSummary(payment)
        && written.createdAt == request.time
        && written.get(field, '') == id
        && written.amount == amount
        && written.uid == request.auth.uid;
    }

    // What a neighbour's booking pays is the area's (kept by the office in bookingFees), and it's either owed or paid online
    function paysBookingFee(communityId, bookingId, booking) {
      let fee = get(/databases/$(database)/documents/communities/$(communityId)).data.get('bookingFees', {}).get(booking.areaId, { 'price': 0, 'deposit': 0 });
      return booking.get('price', 0) == fee.price
        && booking.get('deposit', 0) == fee.deposit
        && booking.get('depositReturnedAt', null) == null
        && ((booking.get('paidAt', null) == null && !('payment' in booking))
          || (fee.price + fee.deposit > 0 && booking.paidAt == request.time
            && paidOnline(communityId, booking.payment, 'bookingId', bookingId, fee.price + fee.deposit)));
    }

    // An administrator's own office, which invoices its fees to the communities they manage
    function ownsOffice(uid) {
      return signedIn() && request.auth.uid == uid && me().role in ['admin', 'superadmin'];
    }

    // Counters move one vote or comment at a time (a vote can go from +1 to -1)
    function changesAtMost(field, max) {
      return math.abs(request.resource.data.get(field, 0) - resource.data.get(field, 0)) <= max;
    }

    match /users/{uid} {
      // Themselves, whoever manages their community and, for neighbours, the managers and administrators of theirs, to know who to ask for access
      allow read: if signedIn() && (
        request.auth.uid == uid
        || manages(resource.data.communityId)
        || (resource.data.role == 'manager' && inCommunity(resource.data.communityId))
        || me().communityId in resource.data.get('communityIds', [])
      );
      allow create: if signedIn() && request.auth.uid == uid && matchesInvitation(request.resource.data);
      // Role and community, by whoever can give both the current and the new ones. Never one's own, so nobody promotes themselves
      allow update: if signedIn() && request.auth.uid != uid && (
        ((changedOnly(['role', 'communityId']) || (isSuperadmin() && changedOnly(['role', 'communityId', 'communityIds'])))
          && canAssign(resource.data.role, resource.data.communityId)
          && canAssign(request.resource.data.role, request.resource.data.communityId))
        // Blocking a neighbour, by whoever manages their community
        || (changedOnly(['blocked'])
          && resource.data.role == 'user'
          && request.resource.data.blocked is bool
          && manages(resource.data.communityId))
      );
      // Out of the community. Their sign-in account stays, and a new invitation gives them a profile again
      allow delete: if signedIn() && request.auth.uid != uid && canAssign(resource.data.role, resource.data.communityId);

      // Property documents (listed and their files) and devices for push notifications.
      // Whoever manages their community can also send them documents (e.g. a certificate), and see and remove those
      match /{collection}/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid
          && collection in ['documents', 'documentFiles', 'devices'];
        allow read, write: if collection in ['documents', 'documentFiles']
          && manages(get(/databases/$(database)/documents/users/$(uid)).data.communityId);
        // The secret key of the issues they report (Issue.authorKey): only they read it, so neighbours can't tell whose
        // issues are. Made once and never changed
        allow get: if signedIn() && request.auth.uid == uid && collection == 'keys';
        allow create: if signedIn() && request.auth.uid == uid && collection == 'keys' && id == 'issues'
          && request.resource.data.keys().hasOnly(['key'])
          && request.resource.data.key is string
          && request.resource.data.key.size() >= 32 && request.resource.data.key.size() <= 64;
      }
    }

    // Their owners see them, and whoever manages the community keeps them, kept in the community they're in.
    // The SEPA mandate (mandate) is the owner's account and ownerNif their NIF (for the 184), so only they and the office see them
    match /properties/{propertyId} {
      // The owner's phone (ownerPhone) as the census has it
      function isPropertyData(data) {
        return data.get('coefficient', 0) is number
          && data.get('ownerPhone', '') is string && data.get('ownerPhone', '').size() <= 40;
      }

      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || manages(resource.data.communityId));
      allow create: if manages(request.resource.data.communityId) && isPropertyData(request.resource.data);
      allow update: if manages(resource.data.communityId) && request.resource.data.communityId == resource.data.communityId
        && isPropertyData(request.resource.data);
      allow delete: if manages(resource.data.communityId);
    }

    // Shared by the communities in communityIds. Whoever shares it can edit it and add or take away only their communities
    match /providers/{providerId} {
      allow read: if sharesWith(resource.data.communityIds);
      allow create: if canShareWith(request.resource.data.communityIds)
        && request.resource.data.communityIds.size() > 0
        && request.resource.data.ratingSum == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if sharesWith(resource.data.communityIds) && (
        // Counters, written along with the user's rating: they move exactly as their rating does
        (changedOnly(['ratingSum', 'ratingCount'])
          && request.resource.data.ratingSum - resource.data.ratingSum
            == getAfter(/databases/$(database)/documents/providers/$(providerId)/ratings/$(request.auth.uid)).data.score - previousScore(providerId)
          && request.resource.data.ratingCount - resource.data.ratingCount
            == (exists(/databases/$(database)/documents/providers/$(providerId)/ratings/$(request.auth.uid)) ? 0 : 1))
        || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ratingSum', 'ratingCount', 'createdBy', 'createdAt'])
          && request.resource.data.communityIds.size() > 0
          && canShareWith(request.resource.data.communityIds.removeAll(resource.data.communityIds))
          && canShareWith(resource.data.communityIds.removeAll(request.resource.data.communityIds)))
      );
      allow delete: if isSuperadmin() || (sharesWith(resource.data.communityIds) && resource.data.createdBy == request.auth.uid);

      // One per person, with their uid as id
      match /ratings/{uid} {
        allow read: if sharesWith(get(/databases/$(database)/documents/providers/$(providerId)).data.communityIds);
        allow create, update: if request.auth.uid == uid
          && sharesWith(get(/databases/$(database)/documents/providers/$(providerId)).data.communityIds)
          && request.resource.data.authorId == uid
          && request.resource.data.score in [1, 2, 3, 4, 5];
        // Along with the provider, by whoever can remove it. Not one by one, the counters would be left wrong
        allow delete: if isSuperadmin()
          || get(/databases/$(database)/documents/providers/$(providerId)).data.createdBy == request.auth.uid;
      }
    }

    // The administrator's office: its fiscal data, invoice counters and the end of its Verifactu chain. The team can
    // read and fix any (support), never their invoices nor records
    match /offices/{uid} {
      allow read: if ownsOffice(uid) || isSuperadmin();
      allow create, update: if ownsOffice(uid) || isSuperadmin();

      // Facturas de honorarios, only to communities they manage. Never removed: corrected with a rectificativa or
      // annulled in the registry; afterwards only what points to those, and to the expense in the community's books
      match /invoices/{invoiceId} {
        allow read: if ownsOffice(uid) || isSuperadmin();
        allow create: if ownsOffice(uid) && manages(request.resource.data.communityId);
        allow update: if ownsOffice(uid) && changedOnly(['rectifiedBy', 'annulled', 'expenseId', 'updatedAt', 'updatedBy']);
      }

      // Registro Verifactu (test mode): each record is chained by its huella to the one before, so it's immutable
      match /verifactu/{recordId} {
        allow read: if ownsOffice(uid) || isSuperadmin();
        allow create: if ownsOffice(uid) && request.resource.data.createdBy == request.auth.uid;
      }
    }

    // Sent by whoever can give that role in that community, and accepted by whoever it's for on their first sign-in.
    // The id is the email in lowercase, as sign-in tokens have it
    match /invitations/{email} {
      allow read: if isInvitee(email) || manages(resource.data.communityId);
      allow create: if canAssign(request.resource.data.role, request.resource.data.communityId)
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'communityId', 'communityIds', 'invitedBy', 'invitedAt'])
        && request.resource.data.email == email
        // Comments are signed with it, so it can't be missing
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.invitedAt == request.time
        && (!('communityIds' in request.resource.data) || isSuperadmin());
      allow delete: if isInvitee(email) || canAssign(resource.data.role, resource.data.communityId);
    }

    // Notifications of the community, sent by whoever manages it
    match /events/{eventId} {
      allow read: if inOrManages(resource.data.communityId);
      allow create: if manages(request.resource.data.communityId);
      // Checked against the community it's in, and kept there, so nobody moves another community's event into theirs
      allow update: if manages(resource.data.communityId)
        && request.resource.data.communityId == resource.data.communityId;
      allow delete: if manages(resource.data.communityId);
    }

    // Partes de trabajo: the link a provider opens without an account to see an issue's job and report back. The token in
    // the id is the only credential, so one can be got by id but they can't be listed. The administration keeps it in the
    // issue's private/admin document
    match /workOrders/{token} {
      // The provider's next step with its visit date, note and photos (Cloudinary only), added to the history one at a time.
      // Accepting only comes first, rescheduling is allowed, and rejecting or finishing ends it. Signed in or not
      function isProviderReport() {
        let before = resource.data;
        let after = request.resource.data;
        let photos = after.get('photos', []);
        return changedOnly(['status', 'scheduledAt', 'photos', 'history', 'updatedAt'])
          && after.updatedAt == request.time
          && before.status in ['sent', 'accepted', 'scheduled']
          && (after.status in ['rejected', 'scheduled', 'done'] || (after.status == 'accepted' && before.status == 'sent'))
          && after.history.size() == before.history.size() + 1
          && after.history.size() <= 20
          // An empty range is an error, not []
          && (before.history.size() == 0 || after.history[0:before.history.size()] == before.history)
          && isStep(after.history[before.history.size()], before, after)
          && photos is list
          && photos.size() <= 10
          && (photos.size() == 0 || (photos.join(' ').matches('https://res[.]cloudinary[.]com/[^ ]{1,300}( https://res[.]cloudinary[.]com/[^ ]{1,300})*')
            && photos.join(' ').split(' ').size() == photos.size()));
      }

      // The step added: the new status, the provider's note and, only when scheduling, the visit date
      function isStep(step, before, after) {
        return step.keys().hasOnly(['at', 'status', 'note', 'scheduledAt'])
          && step.at is timestamp
          && step.status == after.status
          && step.get('note', '') is string
          && step.get('note', '').size() <= 2000
          && ((after.status == 'scheduled' && after.scheduledAt is timestamp && step.get('scheduledAt', null) == after.scheduledAt)
            || (after.status != 'scheduled' && !('scheduledAt' in step) && after.get('scheduledAt', null) == before.get('scheduledAt', null)));
      }

      allow get: if true;
      allow create: if manages(request.resource.data.communityId)
        && token.matches('[A-Za-z0-9_-]{22,64}')
        && request.resource.data.keys().hasOnly(['communityId', 'issueId', 'community', 'issue', 'expectedAt', 'contact', 'provider', 'status', 'history', 'createdAt', 'createdBy', 'updatedAt', 'revokedAt'])
        && request.resource.data.status == 'sent'
        && request.resource.data.history == []
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revokedAt == null;
      // Once revoked nobody can change it. The administration revokes it or brings its expected date up to the issue's
      allow update: if resource.data.revokedAt == null && (isProviderReport()
        || (manages(resource.data.communityId)
          && changedOnly(['revokedAt', 'updatedAt'])
          && request.resource.data.revokedAt == request.time
          && request.resource.data.updatedAt == request.time)
        || (manages(resource.data.communityId)
          && changedOnly(['expectedAt', 'updatedAt'])
          && (request.resource.data.expectedAt == null || request.resource.data.expectedAt is timestamp)
          && request.resource.data.updatedAt == request.time));
      allow delete: if manages(resource.data.communityId);
    }

    // Correo saliente, in the shape of Firebase's Trigger Email extension, which sends each one created once installed (until
    // then they're only kept). Queued by whoever manages the community, the team's (communityId '') by the team. Never changed
    // nor removed from the apps: only the extension writes delivery
    match /mail/{mailId} {
      // Lists of addresses, joined so one regex checks them all, and split back to as many, so none holds several
      function isAddresses(addresses) {
        return addresses is list && (addresses.size() == 0
          || (addresses.join(' ').matches('[^ @]{1,64}@[^ @]{1,255}( [^ @]{1,64}@[^ @]{1,255})*')
            && addresses.join(' ').split(' ').size() == addresses.size()));
      }

      allow read: if manages(resource.data.communityId);
      allow create: if manages(request.resource.data.communityId)
        && request.resource.data.keys().hasOnly(['to', 'cc', 'bcc', 'replyTo', 'message', 'communityId', 'kind', 'mode', 'link', 'createdAt', 'createdBy'])
        && isAddresses(request.resource.data.to)
        && isAddresses(request.resource.data.get('cc', []))
        && isAddresses(request.resource.data.get('bcc', []))
        && request.resource.data.to.size() > 0
        && request.resource.data.to.size() + request.resource.data.get('cc', []).size() + request.resource.data.get('bcc', []).size() <= 50
        && request.resource.data.get('replyTo', '') is string && request.resource.data.get('replyTo', '').size() <= 254
        && request.resource.data.message.keys().hasOnly(['subject', 'text', 'html'])
        && request.resource.data.message.subject is string && request.resource.data.message.subject.size() > 0 && request.resource.data.message.subject.size() <= 300
        && request.resource.data.message.text is string && request.resource.data.message.text.size() <= 200000
        && request.resource.data.message.html is string && request.resource.data.message.html.size() <= 400000
        && request.resource.data.kind in ['invitation', 'meeting-call', 'meeting-minutes', 'work-order', 'claim']
        && request.resource.data.mode in ['demo', 'extension']
        && request.resource.data.link is string && request.resource.data.link.size() <= 300
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    // Errores de las apps (MON-1, docs/fiabilidad.md): one group per failure, by its fingerprint, and samples of who hit it.
    // Anyone signed in reports them, in a set shape and without reading their profile (no me()), so a failing screen costs
    // no extra reads. How often is capped by the browser, the rules can't count it. Only the team reads and manages them
    match /errors/{errorId} {
      // At most 20 releases and 20 screens, the first ones seen
      function hasGroupLists(group) {
        return group.releases is list && group.releases.size() <= 20 && group.releases.join(' ').size() <= 20 * 41
          && group.routes is list && group.routes.size() <= 20 && group.routes.join(' ').size() <= 20 * 81;
      }

      allow read, delete: if isSuperadmin();
      allow create: if signedIn()
        && errorId.matches('[0-9a-f]{16}')
        && request.resource.data.keys().hasOnly(['app', 'kind', 'code', 'message', 'file', 'count', 'sessions', 'firstSeen', 'lastSeen', 'firstRelease', 'lastRelease', 'releases', 'routes', 'status'])
        && request.resource.data.app in ['admin', 'webapp']
        && request.resource.data.kind in ['js', 'firebase', 'carga']
        && request.resource.data.code is string && request.resource.data.code.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.file is string && request.resource.data.file.size() <= 100
        && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 100
        && request.resource.data.sessions in [0, 1]
        && request.resource.data.firstSeen == request.time
        && request.resource.data.lastSeen == request.time
        && request.resource.data.firstRelease is string && request.resource.data.firstRelease.size() <= 40
        && request.resource.data.lastRelease == request.resource.data.firstRelease
        && request.resource.data.releases == [request.resource.data.firstRelease]
        && hasGroupLists(request.resource.data)
        && request.resource.data.status == 'new';
      // Seen again: the counters only go up, at most 100 at a time, and the lists only grow, the new release being this one.
      // The team resolves, ignores, reopens and merges them. Checked in this order so a report never reads the profile
      allow update: if (signedIn()
          && changedOnly(['count', 'sessions', 'lastSeen', 'lastRelease', 'releases', 'routes'])
          && request.resource.data.count is int && request.resource.data.count > resource.data.count && request.resource.data.count <= resource.data.count + 100
          && request.resource.data.sessions - resource.data.sessions in [0, 1]
          && request.resource.data.lastSeen == request.time
          && request.resource.data.lastRelease is string && request.resource.data.lastRelease.size() <= 40
          && request.resource.data.releases.hasAll(resource.data.releases)
          && request.resource.data.releases.toSet().difference(resource.data.releases.toSet()).hasOnly([request.resource.data.lastRelease])
          && request.resource.data.routes.hasAll(resource.data.routes)
          && hasGroupLists(request.resource.data))
        || (changedOnly(['status', 'resolvedAt', 'resolvedBy', 'resolvedIn', 'note', 'mergedInto'])
          && isSuperadmin()
          && request.resource.data.status in ['new', 'resolved', 'ignored']
          && (request.resource.data.get('resolvedAt', null) == resource.data.get('resolvedAt', null) || request.resource.data.resolvedAt == request.time)
          && (request.resource.data.get('resolvedBy', null) == resource.data.get('resolvedBy', null) || request.resource.data.resolvedBy == request.auth.uid)
          && request.resource.data.get('resolvedIn', '') is string && request.resource.data.get('resolvedIn', '').size() <= 40
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 1000
          && request.resource.data.get('mergedInto', '') is string && request.resource.data.get('mergedInto', '') != errorId
          && (request.resource.data.get('mergedInto', '') == '' || request.resource.data.mergedInto.matches('[0-9a-f]{16}')));

      // Kept 30 days (expiresAt), with the user's session as theirs and the server's time
      match /samples/{sampleId} {
        allow read, delete: if isSuperadmin();
        allow create: if signedIn()
          && errorId.matches('[0-9a-f]{16}')
          && request.resource.data.keys().hasOnly(['at', 'expiresAt', 'release', 'app', 'route', 'communityId', 'uid', 'role', 'browser', 'os', 'standalone', 'online', 'message', 'stack', 'trail', 'context'])
          && request.resource.data.at == request.time
          && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt < request.time + duration.value(60, 'd')
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.app in ['admin', 'webapp']
          && request.resource.data.release is string && request.resource.data.release.size() <= 40
          && request.resource.data.route is string && request.resource.data.route.size() <= 100
          && request.resource.data.communityId is string && request.resource.data.communityId.size() <= 40
          && request.resource.data.role is string && request.resource.data.role.size() <= 20
          && request.resource.data.browser is string && request.resource.data.browser.size() <= 40
          && request.resource.data.os is string && request.resource.data.os.size() <= 40
          && request.resource.data.standalone is bool
          && request.resource.data.online is bool
          && request.resource.data.message is string && request.resource.data.message.size() <= 500
          && request.resource.data.stack is string && request.resource.data.stack.size() <= 4096
          && request.resource.data.trail is list && request.resource.data.trail.size() <= 30 && request.resource.data.trail.join('').size() <= 30 * 160
          && request.resource.data.context is map && request.resource.data.context.keys().hasOnly(['source', 'action', 'code', 'info'])
          && request.resource.data.context.source is string && request.resource.data.context.source.size() <= 20
          && request.resource.data.context.get('action', '') is string && request.resource.data.context.get('action', '').size() <= 200
          && request.resource.data.context.get('code', '') is string && request.resource.data.context.get('code', '').size() <= 60
          && request.resource.data.context.get('info', '') is string && request.resource.data.context.get('info', '').size() <= 200;
      }
    }

    // The expired samples of every error at once, for the team's Limpiar caducadas
    match /{path=**}/samples/{sampleId} {
      allow read: if isSuperadmin();
    }

    match /communities/{communityId} {
      allow read: if inCommunity(communityId) || manages(communityId);
      // New ones by gobernança's team, who then assign them. Removing one is left to the console, it also needs its issues, users and properties removed
      allow create: if isSuperadmin();
      // Intereses de demora (lateInterest): the yearly rate in hundredths of a percent, up to 20 %, and the days of grace
      allow update: if manages(communityId)
        && (!('lateInterest' in request.resource.data) || (request.resource.data.lateInterest.keys().hasOnly(['rate', 'graceDays'])
          && request.resource.data.lateInterest.rate is int && request.resource.data.lateInterest.rate > 0 && request.resource.data.lateInterest.rate <= 2000
          && request.resource.data.lateInterest.graceDays is int && request.resource.data.lateInterest.graceDays >= 0 && request.resource.data.lateInterest.graceDays <= 365));

      match /issues/{issueId} {
        function authorPath() {
          return /databases/$(database)/documents/communities/$(communityId)/issues/$(issueId)/private/author;
        }

        allow read: if inOrManages(communityId);

        // By neighbours, or by the administration on their behalf. Neighbours never know who reported one: the issue only
        // has the reporter's secret key (authorKey), and who they are goes in private/author in the same batch
        allow create: if (manages(communityId) || (inCommunity(communityId) && notBlocked()))
          && request.resource.data.communityId == communityId
          && !request.resource.data.keys().hasAny(['createdBy', 'updatedBy'])
          && request.resource.data.get('authorKey', '') is string
          && request.resource.data.get('authorKey', '').size() <= 64
          && getAfter(authorPath()).data.uid == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.votesScore == 0
          && request.resource.data.votesCount == 0
          && request.resource.data.deletedAt == null
          && !request.resource.data.keys().hasAny(['provider', 'expectedAt', 'resolvedAt', 'insuranceClaim']);

        allow update: if inOrManages(communityId) && (
          // Counters, written along with each vote and comment
          (changedOnly(['votesScore', 'votesCount', 'commentsCount'])
            && changesAtMost('votesScore', 2)
            && changesAtMost('votesCount', 1)
            && changesAtMost('commentsCount', 1))
          // Status, provider, expected date and whether there's an insurance claim, by the administration
          || (manages(communityId)
            && changedOnly(['status', 'updatedAt', 'updatedBy', 'resolvedAt', 'provider', 'expectedAt', 'insuranceClaim'])
            && request.resource.data.status in ['open', 'in_progress', 'resolved', 'closed']
            && request.resource.data.updatedBy == request.auth.uid)
          // Removal, by whoever reported it (without signing it, so it doesn't tell who) or the administration
          || ((manages(communityId) || get(authorPath()).data.uid == request.auth.uid)
            && changedOnly(['deletedAt', 'deletedBy'])
            && (request.resource.data.get('deletedBy', '') == resource.data.get('deletedBy', '') || request.resource.data.deletedBy == request.auth.uid))
        );

        // Properties vote, not people: one per property and issue, with the id `${issueId}_${propertyId}`, cast by its owner.
        // Dated by the server, so a vote can't be backdated to a past month to skip the monthly limit
        // (the limit itself is checked by the app: rules can't count documents)
        match /votes/{voteId} {
          allow read: if inCommunity(communityId);
          allow create, update: if inCommunity(communityId)
            && notBlocked()
            && request.resource.data.keys().hasOnly(['propertyId', 'voterId', 'score', 'votedAt'])
            && voteId == issueId + '_' + request.resource.data.propertyId
            && ownsProperty(communityId, request.resource.data.propertyId)
            && request.resource.data.voterId == request.auth.uid
            && request.resource.data.score in [1, -1]
            && request.resource.data.votedAt == request.time;
          // Also by a new owner, the vote is the property's
          allow delete: if inCommunity(communityId) && ownsProperty(communityId, resource.data.propertyId);
        }

        // Messages, and status changes by the administration
        match /comments/{commentId} {
          allow read: if inOrManages(communityId);
          allow create: if inOrManages(communityId)
            && notBlocked()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.get('authorName', '') == me().get('name', '')
            && request.resource.data.deletedAt == null
            && (request.resource.data.get('type', 'message') == 'message' || manages(communityId))
            && (!('authorRole' in request.resource.data) || manages(communityId));
          // Removing their own, or hiding and showing it again by the administration
          allow update: if (inOrManages(communityId)
              && resource.data.authorId == request.auth.uid
              && changedOnly(['deletedAt', 'deletedBy']))
            || (manages(communityId)
              && changedOnly(['hiddenAt', 'hiddenBy'])
              && request.resource.data.hiddenBy == request.auth.uid);
        }

        // The internal note and the insurance claim (admin) and who reported it (author), neighbours never see them
        match /private/{docId} {
          allow read: if manages(communityId);
          allow write: if manages(communityId) && docId != 'author';
          // Written with the issue by whoever reports it, and never changed
          allow create: if docId == 'author'
            && inOrManages(communityId)
            && request.resource.data.keys().hasOnly(['uid'])
            && request.resource.data.uid == request.auth.uid
            && !exists(/databases/$(database)/documents/communities/$(communityId)/issues/$(issueId))
            && existsAfter(/databases/$(database)/documents/communities/$(communityId)/issues/$(issueId));
        }
      }

      // Who changed what. Signed by whoever makes the change, dated by the server and never edited
      match /activity/{activityId} {
        allow read: if manages(communityId);
        allow create: if manages(communityId)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.byName in [me().get('name', ''), request.auth.token.get('email', ''), '']
          && request.resource.data.at == request.time;
      }

      // Juntas. Neighbours see them once convened
      match /meetings/{meetingId} {
        allow read: if manages(communityId) || (inCommunity(communityId) && resource.data.status != 'draft');
        allow write: if manages(communityId) && request.resource.data.communityId == communityId;
        allow delete: if manages(communityId);
        // A signer of the acta adds themselves to minutesSigned when signing, for the webapp's list
        allow update: if inCommunity(communityId)
          && request.auth.uid in resource.data.get('minutesSigners', [])
          && changedOnly(['minutesSigned'])
          && request.resource.data.minutesSigned.toSet() == resource.data.get('minutesSigned', []).toSet().union([request.auth.uid].toSet());

        // Each neighbour answers for themselves, with their uid as id
        match /attendance/{uid} {
          allow read: if inOrManages(communityId);
          allow create, update: if manages(communityId)
            || (inCommunity(communityId) && notBlocked()
              && uid == request.auth.uid
              && request.resource.data.uid == uid
              && isMyName(request.resource.data.get('name', ''))
              && request.resource.data.status in ['attending', 'absent', 'delegated']);
          allow delete: if manages(communityId) || (inCommunity(communityId) && uid == request.auth.uid);
        }

        // One per agenda item and property, as `${itemId}_${propertyId}`, weighted with the property's coefficient.
        // Owners vote theirs while voting is open, the administration records any (e.g. delegated ones).
        // Not named votes, so the collection group query of issue votes doesn't count them
        match /ballots/{voteId} {
          allow read: if inOrManages(communityId);
          allow write: if manages(communityId);
          allow create, update: if inCommunity(communityId) && notBlocked()
            && get(/databases/$(database)/documents/communities/$(communityId)/meetings/$(meetingId)).data.get('votingOpen', false) == true
            && voteId == request.resource.data.itemId + '_' + request.resource.data.propertyId
            && request.resource.data.voterId == request.auth.uid
            && request.resource.data.choice in ['yes', 'no', 'abstain']
            && request.resource.data.votedAt == request.time
            && ownsWithCoefficient(communityId, request.resource.data.propertyId, request.resource.data.coefficient)
            && isMyName(request.resource.data.get('voterName', ''));
        }

        // The acta (packages/shared/domain/minutes.ts), one per meeting. Whoever manages the community edits its text and
        // signers until both have signed, which takes off the signatures there were. Each signer signs their own slot, or
        // whoever manages it signs it for them in person. Then it's sealed with its hash and never changes again.
        // The signers read it to sign it, the owners once it's sent to them
        match /minutes/{minutesId} {
          function signers() {
            return [resource.data.president.uid, resource.data.secretary.uid];
          }

          function bothSigned() {
            return resource.data.signatures.keys().hasAll(['president', 'secretary']);
          }

          function isSigner(signer) {
            return signer.keys().hasOnly(['uid', 'name'])
              && signer.uid is string && signer.uid.size() > 0
              && signer.name is string && signer.name.size() <= 100;
          }

          // Firma electrónica simple: the stroke and who was signed in, dated by the server. With get(), as indexing the
          // other slot, not signed yet, would fail the whole rule
          function signs(role) {
            let before = resource.data.signatures;
            let after = request.resource.data;
            let signature = after.signatures.get(role, null);
            return signature != null
              && !(role in before)
              && after.signatures.diff(before).affectedKeys().hasOnly([role])
              && signature.keys().hasOnly(['uid', 'name', 'path', 'signedAt', 'byUid', 'byEmail'])
              && signature.uid == after[role].uid
              && signature.name == after[role].name
              && signature.signedAt == request.time
              && signature.byUid == request.auth.uid
              && signature.byEmail == request.auth.token.email
              && (signature.uid == request.auth.uid || manages(communityId))
              && signature.path is string
              && signature.path.size() <= 20000
              && signature.path.matches('M[0-9]+ [0-9]+( [ML][0-9]+ [0-9]+)*');
          }

          allow read: if manages(communityId) || (inCommunity(communityId) && (request.auth.uid in signers()
            || get(/databases/$(database)/documents/communities/$(communityId)/meetings/$(meetingId)).data.get('notifiedAt', {}).get('minutes', null) != null));
          allow create, update: if manages(communityId)
            && minutesId == 'record'
            && (resource == null || (resource.data.closedAt == null && !bothSigned()))
            && request.resource.data.keys().hasOnly(['communityId', 'meetingId', 'text', 'president', 'secretary', 'signatures', 'hash', 'closedAt', 'updatedAt', 'updatedBy'])
            && request.resource.data.communityId == communityId
            && request.resource.data.meetingId == meetingId
            && request.resource.data.text is string && request.resource.data.text.size() <= 100000
            && isSigner(request.resource.data.president)
            && isSigner(request.resource.data.secretary)
            && request.resource.data.signatures == {}
            && request.resource.data.hash == ''
            && request.resource.data.closedAt == null
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid;
          allow update: if resource.data.closedAt == null && notBlocked()
            && changedOnly(['signatures'])
            && (signs('president') || signs('secretary'));
          // Sealed once both have signed, by whoever signs last (from the webapp too) or from the admin
          allow update: if (manages(communityId) || (inCommunity(communityId) && request.auth.uid in signers()))
            && resource.data.closedAt == null && bothSigned()
            && changedOnly(['hash', 'closedAt'])
            && request.resource.data.hash.matches('[0-9a-f]{64}')
            && request.resource.data.closedAt == request.time;
        }

        // The convocatoria or the acta sent to each owner (minutes.ts), as {kind}_{uid}, or {kind}_p{propertyId} without an
        // account. Whoever manages the community sends them and only adds the dissents received outside the app. Each owner reads theirs, marks it read and
        // acknowledged once and, absent from the meeting, dissents from each voted agreement within 30 days (art. 17.8 LPH)
        match /notices/{noticeId} {
          function isMine() {
            return noticeId in ['call_' + request.auth.uid, 'minutes_' + request.auth.uid] && inCommunity(communityId);
          }

          function setsOnce(field) {
            return changedOnly([field]) && resource.data.get(field, null) == null && request.resource.data[field] == request.time;
          }

          // One agreement at a time, dated by the server: past dissents were dated before, so request.time can only be the one added
          function dissents() {
            let added = request.resource.data.dissent.diff(resource.data.dissent);
            return changedOnly(['dissent'])
              && resource.data.kind == 'minutes'
              && resource.data.absent == true
              && request.time < resource.data.sentAt + duration.value(30, 'd')
              && added.changedKeys().size() == 0
              && added.removedKeys().size() == 0
              && added.addedKeys().size() == 1
              && added.addedKeys().hasOnly(resource.data.items)
              && request.time in request.resource.data.dissent.values();
          }

          // A dissent received by post, burofax or in person, from an owner with an account or without: recorded by the
          // administration apart from the owner's own, one agreement at a time with the day it arrived, and taken back only by it
          function recordsDissent() {
            let before = resource.data.get('recordedDissent', {});
            let after = request.resource.data.recordedDissent;
            let changes = after.diff(before);
            let added = after.values().removeAll(before.values());
            return changedOnly(['recordedDissent'])
              && resource.data.kind == 'minutes'
              && resource.data.absent == true
              && changes.changedKeys().size() == 0
              && ((changes.addedKeys().size() == 0 && changes.removedKeys().size() == 1)
                || (changes.removedKeys().size() == 0
                  && changes.addedKeys().size() == 1
                  && changes.addedKeys().hasOnly(resource.data.items)
                  && added.size() == 1
                  && added[0].keys().hasOnly(['receivedOn', 'recordedAt', 'recordedBy'])
                  && added[0].receivedOn is timestamp
                  && added[0].receivedOn <= request.time
                  && added[0].recordedAt == request.time
                  && added[0].recordedBy == request.auth.uid));
          }

          // Owners get theirs by id, only the administration lists them
          allow get: if manages(communityId) || isMine();
          allow list: if manages(communityId);
          allow create: if manages(communityId)
            && request.resource.data.keys().hasOnly(['kind', 'uid', 'name', 'email', 'propertyIds', 'propertyNames', 'coefficient', 'absent', 'items', 'app', 'certified', 'sentAt', 'sentBy', 'readAt', 'receivedAt', 'dissent'])
            && request.resource.data.kind in ['call', 'minutes']
            && ((request.resource.data.uid != '' && noticeId == request.resource.data.kind + '_' + request.resource.data.uid)
              || (request.resource.data.uid == '' && noticeId == request.resource.data.kind + '_p' + request.resource.data.propertyIds[0]))
            && request.resource.data.app == (request.resource.data.uid != '')
            && request.resource.data.certified.keys().hasOnly(['mode', 'reference'])
            && request.resource.data.certified.mode == 'test'
            && request.resource.data.sentAt == request.time
            && request.resource.data.sentBy == request.auth.uid
            && request.resource.data.readAt == null
            && request.resource.data.receivedAt == null
            && request.resource.data.dissent == {};
          // Blocked owners too: blocking stops spam, not their rights as owners
          allow update: if isMine() && (setsOnce('readAt') || setsOnce('receivedAt') || dissents());
          allow update: if manages(communityId) && recordsDissent();
        }
      }

      // Recibos and derramas. Owners see theirs. The year's fees from the budget share batchId fees-{year} and carry
      // their part for the fondo de reserva (reserve). A domiciliated one points to its remittance and keeps its returns.
      // Those imported from another program (the debt brought when migrating) share batchId import.
      // Owners pay theirs from the app while online payments are in test mode: only the payment, dated by the server,
      // never one already paid or being domiciliated, of what the entregas a cuenta left. The office marking it unpaid
      // again removes the payment.
      // Entregas a cuenta (collections, their sum in collected and their years) and a recibo de intereses' charges and
      // the day it counts until (interest) are the office's. Each entrega is added last, so the last one is checked
      match /charges/{chargeId} {
        function isCollection(item) {
          return item.keys().hasOnly(['id', 'amount', 'date', 'method', 'note'])
            && item.id is string && item.id.size() <= 40
            && item.amount is int && item.amount > 0
            && item.date is timestamp
            && item.method in ['cash', 'transfer', 'card', 'other']
            && item.get('note', '') is string && item.get('note', '').size() <= 200;
        }

        function isChargeData(charge) {
          let collections = charge.get('collections', []);
          let collected = charge.get('collected', 0);
          return collections is list && collections.size() <= 100
            && (collections.size() == 0 || isCollection(collections[collections.size() - 1]))
            && collected is int && collected >= 0 && collected <= charge.amount
            && charge.get('collectionYears', []) is list && charge.get('collectionYears', []).size() <= 100
            && (!('interest' in charge) || (charge.interest.keys().hasOnly(['chargeIds', 'to'])
              && charge.interest.chargeIds is list && charge.interest.chargeIds.size() <= 500
              && charge.interest.to is string && charge.interest.to.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
        }

        allow read: if manages(communityId) || (inCommunity(communityId) && resource.data.ownerUid == request.auth.uid);
        allow create, update: if manages(communityId) && request.resource.data.communityId == communityId && isChargeData(request.resource.data);
        allow update: if inCommunity(communityId) && notBlocked()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.paidAt == null
          && !('remittanceId' in resource.data)
          && changedOnly(['paidAt', 'payment', 'updatedAt', 'updatedBy'])
          && request.resource.data.paidAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && paidOnline(communityId, request.resource.data.payment, 'chargeId', chargeId, resource.data.amount - resource.data.get('collected', 0));
        allow delete: if manages(communityId);
      }

      // Pagos online, made by neighbours from the app for one of their charges or bookings, written along with it.
      // Only in test mode (no money moves), with no card number: its brand and last 4 digits at most.
      // The office can mark one reverted (and undo it), or reconciled with the gateway's payout in the bank
      // (bankMovementId), the payment itself is never removed
      match /payments/{paymentId} {
        allow read: if manages(communityId) || (inCommunity(communityId) && resource.data.uid == request.auth.uid);
        allow create: if inCommunity(communityId) && notBlocked() && testPayments(communityId)
          && request.resource.data.keys().hasOnly(['communityId', 'mode', 'method', 'amount', 'uid', 'chargeId', 'bookingId', 'card', 'createdAt'])
          && request.resource.data.communityId == communityId
          && request.resource.data.mode == 'test'
          && request.resource.data.method in ['card', 'bizum']
          && request.resource.data.amount is int && request.resource.data.amount > 0
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && isCardSummary(request.resource.data)
          && (('chargeId' in request.resource.data
              && getAfter(/databases/$(database)/documents/communities/$(communityId)/charges/$(request.resource.data.chargeId)).data.get('payment', {}).get('id', '') == paymentId)
            || ('bookingId' in request.resource.data
              && getAfter(/databases/$(database)/documents/communities/$(communityId)/bookings/$(request.resource.data.bookingId)).data.get('payment', {}).get('id', '') == paymentId));
        allow update: if manages(communityId) && changedOnly(['revertedAt', 'revertedBy']) && request.resource.data.get('revertedBy', request.auth.uid) == request.auth.uid;
        allow update: if manages(communityId) && changedOnly(['bankMovementId'])
          && (!('bankMovementId' in request.resource.data)
            || exists(/databases/$(database)/documents/communities/$(communityId)/bankMovements/$(request.resource.data.bankMovementId)));
      }

      // Reclamaciones of a property's debt, one per property (its id): the claims sent and the monitorio's data. Only the office
      match /debtCases/{propertyId} {
        allow read, delete: if manages(communityId);
        allow create, update: if manages(communityId) && request.resource.data.propertyId == propertyId;
      }

      // Remesas of domiciliated charges (SEPA direct debit), with each debtor's account. Only the office: the owners'
      // mandates are in their properties
      match /remittances/{remittanceId} {
        allow read, write: if manages(communityId);
      }

      // Órdenes de pago to providers (SEPA credit transfer), with each provider's account. Only the office
      match /paymentOrders/{orderId} {
        allow read, write: if manages(communityId);
      }

      // Movements of the community's bank account, imported from its statements (or the test bank feed) and reconciled
      // with the charges, invoices, remittances and orders they paid, which point back to them (bankMovementId). Only the office
      match /bankMovements/{movementId} {
        allow read, write: if manages(communityId);
      }

      // Contabilidad. Every entry is derived from the charges and invoices but the manual ones, which can't be written
      // in a closed year (one with its fiscalYears doc), nor moved into or out of one. The closing keeps the
      // regularization and closing entries, the latter opens the next year. The chart doc keeps the accounts added.
      // Incomes from third parties (income, for the 184 and 347) are manual entries too, so they close with the year
      match /journalEntries/{entryId} {
        allow read: if manages(communityId);
        allow create: if manages(communityId) && request.resource.data.year is int
          && !exists(/databases/$(database)/documents/communities/$(communityId)/fiscalYears/$(string(request.resource.data.year)));
        allow update: if manages(communityId) && request.resource.data.year is int
          && !exists(/databases/$(database)/documents/communities/$(communityId)/fiscalYears/$(string(request.resource.data.year)))
          && !exists(/databases/$(database)/documents/communities/$(communityId)/fiscalYears/$(string(resource.data.year)));
        allow delete: if manages(communityId)
          && !exists(/databases/$(database)/documents/communities/$(communityId)/fiscalYears/$(string(resource.data.year)));
      }

      match /fiscalYears/{year} {
        allow read, write: if manages(communityId);
      }

      match /accounting/{docId} {
        allow read, write: if manages(communityId) && docId == 'chart';
      }

      // The budget and its expenses, open to every neighbour. Expenses are also the supplier invoices, with their taxes
      // and whether they're paid (paidAt null while owed) or going in a transfer order (paymentOrderId). The budget
      // keeps the fondo de reserva (contribution and opening balance) and how the year's fees were issued; an expense
      // may be paid from that fund (fromReserve)
      match /budgets/{year} {
        allow read: if inOrManages(communityId);
        allow write: if manages(communityId);
      }

      match /expenses/{expenseId} {
        allow read: if inOrManages(communityId);
        allow write: if manages(communityId);
      }

      // Inspections, revisions and renewals
      match /obligations/{obligationId} {
        allow read, write: if manages(communityId);
      }

      // Common areas. The id is `${areaId}_${date}_${from}`, so creating a booked slot again is an update, which only
      // changes its payment. Areas with a price or fianza (bookingFees) are owed (paidAt null) or paid online; the
      // office marks them paid and the fianza returned. Neighbours can't cancel one that's paid, the office does
      match /bookings/{bookingId} {
        allow read: if inOrManages(communityId);
        allow create: if (manages(communityId) || (inCommunity(communityId) && notBlocked() && request.resource.data.uid == request.auth.uid && isMyName(request.resource.data.get('name', ''))
            && paysBookingFee(communityId, bookingId, request.resource.data)))
          && request.resource.data.communityId == communityId
          && bookingId == request.resource.data.areaId + '_' + request.resource.data.date + '_' + request.resource.data.from;
        allow update: if (manages(communityId) && changedOnly(['paidAt', 'payment', 'depositReturnedAt', 'updatedAt', 'updatedBy']))
          || (inCommunity(communityId) && notBlocked()
            && resource.data.uid == request.auth.uid
            && resource.data.get('paidAt', 0) == null
            && changedOnly(['paidAt', 'payment'])
            && request.resource.data.paidAt == request.time
            && paidOnline(communityId, request.resource.data.payment, 'bookingId', bookingId, resource.data.get('price', 0) + resource.data.get('deposit', 0)));
        allow delete: if manages(communityId) || (inCommunity(communityId) && resource.data.uid == request.auth.uid && resource.data.get('paidAt', null) == null);
      }
    }

    // The votes each user has given, counted across all issues for their stats on the home page
    match /{path=**}/votes/{voteId} {
      allow read: if signedIn() && resource.data.voterId == request.auth.uid;
    }
  }
}
