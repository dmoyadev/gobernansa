# Project URLs
VITE_API_URL='' # @required URL where API calls should point to (e.g. https://api.example.com)

# Where the admin's "Ver como vecino" opens the webapp, https://gobernansa.dmoya.dev when missing
VITE_WEBAPP_URL='http://localhost:5400'

# Project configuration
VITE_ENV_NAME='example' # @required Name of the environment (e.g. local, staging, production)

VITE_FAKE_METRICS='true' # Whether to fake metrics or not (e.g. true, false)

# Firebase configuration
VITE_FIREBASE_EMULATORS=false # Use local Auth + Firestore emulators (`firebase emulators:start`)
VITE_FIREBASE_API_KEY='<API_KEY>'
VITE_FIREBASE_AUTH_DOMAIN='<AUTH_DOMAIN>'
VITE_FIREBASE_PROJECT_ID='<PROJECT_ID>'
VITE_FIREBASE_STORAGE_BUCKET='<STORAGE_BUCKET>'
VITE_FIREBASE_MESSAGING_SENDER_ID='<MESSAGING_SENDER_ID>'
VITE_FIREBASE_APP_ID='<APP_ID>'
VITE_FIREBASE_MEASUREMENT_ID='<MEASUREMENT_ID>'
VITE_FIREBASE_VAPID_KEY='<VAPID_KEY>'
VITE_ANALYTICS_TRACKING_ID='<TRACKING_ID>'

# Cloudinary, where issue photos and videos are uploaded (Cloud Storage needs Firebase's paid plan)
VITE_CLOUDINARY_CLOUD_NAME='<CLOUD_NAME>'
VITE_CLOUDINARY_UPLOAD_PRESET='<UNSIGNED_UPLOAD_PRESET>' # Settings → Upload → Upload presets, signing mode "Unsigned"
