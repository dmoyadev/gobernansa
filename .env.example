# Every variable the apps and the scripts read. Copy this file to:
# - .env.local: local development (npm run dev, against the emulators) and the local demo (npm run demo)
# - .env.demo.local: the demo project (npm run deploy:demo, npm run seed:demo, docs/firebase.md)
# Both are ignored by git. The deploys from GitHub take the VITE_* ones from the repository's secrets, with the same names
# (.github/workflows). Variables already set in the shell win over these files

# ─── Apps (both, read when building) ─────────────────────────────────────────────────────────────────────────────────

# Shown after the tab title when the build isn't production, e.g. "LOCAL" or "DEMO". Empty: the Vite mode
VITE_ENV_NAME='local'

# Where the webapp is. The admin uses it for "Ver como vecino", the invitation emails and the work order links sent to
# providers. https://gobernansa.dmoya.dev when empty, so in development and in the demo it must be their own webapp, or
# those links open production. npm run dev serves it at https://localhost:5400
VITE_WEBAPP_URL='https://localhost:5400'

# What happens to the emails the admin queues in Firestore's mail collection (invitations, notices of meetings, minutes,
# work orders, claims): 'demo' only keeps them in the admin's Correo saliente; 'extension' once Firebase's Trigger Email
# extension sends them (docs/firebase.md)
VITE_MAIL_MODE='demo'

# ─── Firebase (Firebase console → Project settings → Your apps → Web) ────────────────────────────────────────────────

# 'true' to use the local emulators (Auth, Firestore, Storage and Functions, firebase.json) instead of the real project.
# Their data is the seed's and is reset each time. Anything else: the project below
VITE_FIREBASE_EMULATORS='false'

# The web app's config, as the console shows it. With the emulators only the project id matters: it must be the one the
# emulators run with (.firebaserc), or they'd see an empty database
VITE_FIREBASE_API_KEY='<API_KEY>'
VITE_FIREBASE_AUTH_DOMAIN='<PROJECT_ID>.firebaseapp.com'
VITE_FIREBASE_PROJECT_ID='<PROJECT_ID>'
VITE_FIREBASE_MESSAGING_SENDER_ID='<MESSAGING_SENDER_ID>'
VITE_FIREBASE_APP_ID='<APP_ID>'

# The Storage bucket where the photos and videos of issues and work orders go (storage.rules). Empty: the apps hide the
# pickers. A real project needs Firebase's paid plan (Blaze) for it, so leave it empty there until then; the emulators
# don't
VITE_FIREBASE_STORAGE_BUCKET='<PROJECT_ID>.firebasestorage.app'

# Google Analytics' id (G-…), only if Analytics is turned on in the project. Can be empty
VITE_FIREBASE_MEASUREMENT_ID=''

# Cloud Messaging → Web Push certificates → Generate. Without it the webapp can't ask for push notifications
VITE_FIREBASE_VAPID_KEY=''

# App Check's reCAPTCHA Enterprise key id (docs/firebase.md, section 9). Empty: no App Check. Ignored with the emulators
VITE_APP_CHECK_KEY=''

# Set by the deploys (npm run deploy:demo and the GitHub workflows) to date and commit, e.g. 2026.11.15-1030-abc1234,
# so each error says which version it came from (Errores in the admin). Don't set it by hand: 'local' when missing
# VITE_RELEASE=''

# ─── Scripts (node, read from the shell or these files) ──────────────────────────────────────────────────────────────

# Password of every account of the seed (scripts/seed/data/cast.js), so they can sign in without the sign-in
# email: in .env.local, the emulators' and the local demo's; in .env.demo.local, the demo project's. Easy to type on a
# phone, at least 6 characters. Required by npm run seed:demo
DEMO_PASSWORD='<DEMO_PASSWORD>'

# Where npm run backup leaves the encrypted copies, ~/Documents/Backups/gobernansa when empty (scripts/backup)
# BACKUP_DIR=''

# The file with the backups' encryption key, ~/.config/gobernansa/backup.key when empty. Without it no copy can be
# restored: keep it somewhere else too
# BACKUP_KEY=''
