{
	"name": "gobernansa",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite --mode localhost --host --port 5400",
		"build": "rm -rf dist && npm run check-typing && vite build",
		"preview": "vite preview --host --port 4400",
		"lint": "eslint --fix",
		"check-typing": "vue-tsc --build --noEmit",
		"check-deps": "npx taze",
		"seed-firebase": "node ./scripts/firebase-test/seed.js --reset",
		"seed-firebase:emulators": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node ./scripts/firebase-test/seed.js --reset",
		"start:firebase:emulators": "firebase emulators:start"
	},
	"dependencies": {
		"firebase": "^12.19.0",
		"iconify-icon": "^3.0.4",
		"lnxjs-components": "^0.7.11",
		"vue": "^3.5.44",
		"vue-router": "^5.4.0",
		"vuefire": "^3.2.3"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^7.7.3",
		"@types/node": "^24.19.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"eslint": "^9.39.5",
		"eslint-plugin-vue": "^10.12.0",
		"firebase-admin": "^13.10.0",
		"firebase-tools": "^15.34.1",
		"jiti": "^2.7.0",
		"sass-embedded": "^1.106.1",
		"typescript": "~5.9.3",
		"vite": "8.3.5",
		"vite-plugin-mkcert": "^1.17.12",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vue-tsc": "^3.3.13"
	}
}
