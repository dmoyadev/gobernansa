{
	"name": "gobernansa",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:webapp": "npm run dev -w apps/webapp",
		"dev:admin": "npm run dev -w apps/admin",
		"dev": "concurrently --kill-others-on-fail \"npm run start:firebase:emulators\" \"npm run seed-firebase:emulators -- --reset\" \"npm run dev -w apps/webapp\" \"npm run dev -w apps/admin\"",
		"build": "npm run build -w apps/webapp -w apps/admin",
		"lint": "eslint --fix",
		"check-typing": "npm run check-typing -w apps/webapp -w apps/admin",
		"check-deps": "npx taze -r",
		"seed-firebase": "node ./scripts/firebase-test/seed.js",
		"seed-firebase:emulators": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node ./scripts/firebase-test/seed.js",
		"start:firebase:emulators": "firebase emulators:start",
		"backup": "node ./scripts/backup/backup.js",
		"restore": "node ./scripts/backup/restore.js",
		"symbolicate": "node ./scripts/symbolicate.js"
	},
	"dependencies": {
		"firebase": "^12.19.0",
		"iconify-icon": "^3.0.4",
		"lnxjs-components": "^0.7.11",
		"uqr": "^0.1.3",
		"vue": "^3.5.44",
		"vue-router": "^5.4.0",
		"vuefire": "^3.2.3"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^7.7.3",
		"@inquirer/prompts": "^7.10.1",
		"@types/node": "^24.19.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"concurrently": "^10.0.5",
		"eslint": "^9.39.5",
		"eslint-plugin-vue": "^10.12.0",
		"firebase-admin": "^13.10.0",
		"firebase-tools": "^15.34.1",
		"jiti": "^2.7.0",
		"sass-embedded": "^1.106.1",
		"typescript": "~5.9.3",
		"vite": "8.3.5",
		"vite-plugin-mkcert": "^1.17.12",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vue-tsc": "^3.3.13"
	}
}
