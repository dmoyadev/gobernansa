{
	"name": "gobernansa",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently --kill-others-on-fail \"npm run emulators\" \"npm run seed:emulators -- --reset\" \"npm run dev -w apps/webapp\" \"npm run dev -w apps/admin\"",
		"dev:webapp": "npm run dev -w apps/webapp",
		"dev:admin": "npm run dev -w apps/admin",
		"emulators": "JAVA_TOOL_OPTIONS='-Duser.language=en -Duser.country=US' firebase emulators:start",
		"check": "concurrently --group --names lint,webapp,admin \"eslint .\" \"npm run check:types -w apps/webapp\" \"npm run check:types -w apps/admin\"",
		"check:types": "npm run check:types -w apps/webapp -w apps/admin",
		"check:deps": "npx taze -r",
		"lint": "eslint --fix",
		"build": "npm run build -w apps/webapp -w apps/admin",
		"clean": "rm -rf dist apps/*/dist node_modules/.vite apps/*/node_modules/.vite node_modules/.demo *.log *.tsbuildinfo apps/*/*.tsbuildinfo",
		"seed": "node --env-file-if-exists=.env.demo.local ./scripts/seed/seed.js",
		"seed:demo": "node --env-file-if-exists=.env.demo.local ./scripts/seed/seed.js --demo --reset",
		"seed:emulators": "METADATA_SERVER_DETECTION=none FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 node --env-file-if-exists=.env.local ./scripts/seed/seed.js",
		"demo": "node --env-file-if-exists=.env.local ./scripts/demo.js",
		"demo:reset": "node --env-file-if-exists=.env.local ./scripts/demo.js --reset",
		"deploy:demo": "node ./scripts/deploy-demo.js",
		"backup": "node --env-file-if-exists=.env.local ./scripts/backup/backup.js",
		"restore": "node --env-file-if-exists=.env.local ./scripts/backup/restore.js",
		"purge": "node --env-file-if-exists=.env.local ./scripts/backup/purge.js",
		"symbolicate": "node ./scripts/symbolicate.js"
	},
	"dependencies": {
		"firebase": "^12.19.0",
		"iconify-icon": "^3.0.4",
		"lnxjs-components": "^0.10.0",
		"uqr": "^0.1.3",
		"vue": "^3.5.44",
		"vue-router": "^5.4.0",
		"vuefire": "^3.2.3"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^7.7.3",
		"@iconify-json/lucide": "^1.2.155",
		"@inquirer/prompts": "^7.10.1",
		"@types/node": "^24.19.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"concurrently": "^10.0.5",
		"eslint": "^9.39.5",
		"eslint-plugin-vue": "^10.12.0",
		"firebase-admin": "^13.10.0",
		"firebase-tools": "^15.34.1",
		"jiti": "^2.7.0",
		"sass-embedded": "^1.106.1",
		"source-map-js": "^1.2.2",
		"typescript": "~5.9.3",
		"vite": "8.3.5",
		"vite-plugin-mkcert": "^1.17.12",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vue-tsc": "^3.3.13"
	},
	"overrides": {
		"@firebase/firestore": {
			"@grpc/grpc-js": "^1.14.6"
		}
	}
}
